# d2-diagram preset: mono — Everything in IBM Plex Mono on a neutral grey palette. Engineering docs without forced caps.
# Shared style for every diagram in this folder; diagrams import it via ...@_style. Edit freely.
vars: {
  d2-config: {
    theme-id: 1
    sketch: false
    layout-engine: elk
    pad: 32
    data: {font: plex-mono; default-format: png; animated-format: gif; animate-interval: 1200}
  }
}
