# Release pipeline — a linear flow with a decision and parallel jobs.
# Probes: person, container with a fan-out, diamond, package, cloud, step, dashed failure edges.
# Pipelines are wide by nature; expect roughly 2.3:1 on dagre and 3:1 on elk.
direction: right

title: Release pipeline {
  near: top-center
  shape: text
  style: {font-size: 24; bold: true}
}

dev: Developer {shape: person}

ci: CI {
  build: Build
  unit: Unit tests
  lint: Lint
  scan: Security scan
  build -> unit
  build -> lint
  build -> scan
}

artifact: Image {shape: package}
gate: All green? {shape: diamond}
staging: Staging {shape: cloud}
rollback: Roll back {shape: step}
approve: Release manager {shape: person}
prod: Production {shape: cloud}

dev -> ci.build: push
ci.build -> artifact
ci.unit -> gate
ci.lint -> gate
ci.scan -> gate
gate -> staging: yes
gate -> rollback: no {style.stroke-dash: 3}
artifact -> staging
staging -> prod
approve -> prod: approves
