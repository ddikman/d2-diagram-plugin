# d2-diagram preset: vivid-sketch — Colourful hand-drawn style for slides and talks.
# Shared style for every diagram in this folder; diagrams import it via ...@_style. Edit freely.
vars: {
  d2-config: {
    theme-id: 6
    sketch: true
    layout-engine: dagre
    pad: 32
    data: {font: default; default-format: png; animated-format: gif; animate-interval: 1200}
  }
}

# House style: made for projection — large bold labels and heavy strokes.
***.style.font-size: 20
***.style.bold: true
***.style.stroke-width: 3
(*** -> ***)[*].style.stroke-width: 3
(*** -> ***)[*].style.font-size: 18

# d2 sizes a person from its label, so a long name stretches the icon sideways.
# Pinning the box keeps people looking like people; the label still sits below it.
***: {&shape: person; width: 64; height: 88}
