# d2-diagram preset: origami — Paper-like folded look with the Lora serif.
# Shared style for every diagram in this folder; diagrams import it via ...@_style. Edit freely.
vars: {
  d2-config: {
    theme-id: 302
    sketch: false
    layout-engine: dagre
    pad: 32
    data: {font: lora; default-format: png; animated-format: gif; animate-interval: 1200}
  }
}
