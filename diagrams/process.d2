...@_style

# A row of chevrons: the order is the picture, so there are no arrows to label.
# A grid keeps it as narrow as the steps; past five steps, grid-columns wraps it.
grid-rows: 1
grid-gap: 16

placed: Order placed {shape: step}
pick: Pick {shape: step}
pack: Pack {
  shape: step
  style.stroke: "#c8401f"
  style.font-color: "#c8401f"
}
ship: Ship {shape: step}
delivered: Delivered {shape: step}
