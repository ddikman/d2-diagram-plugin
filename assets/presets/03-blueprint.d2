# d2-diagram preset: blueprint — Cool blues with orthogonal routing (ELK) and the Inter font. Recommended for architecture and infra docs kept in a repo.
# Shared style for every diagram in this folder; diagrams import it via ...@_style. Edit freely.
vars: {
  d2-config: {
    theme-id: 4
    sketch: false
    layout-engine: elk
    pad: 32
    data: {font: inter; default-format: png; animated-format: gif; animate-interval: 1200}
  }
}
