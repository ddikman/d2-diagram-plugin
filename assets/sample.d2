direction: right

title: Checkout — request path {
  near: top-center
  shape: text
  style: {font-size: 24; bold: true}
}

client: Web client {shape: person}
admin: Ops console {shape: person}

checkout: Checkout service {
  api: API
  worker: Worker
  api -> worker: enqueue
}

cache: Session cache {shape: cylinder}
events: Order events {shape: queue}
psp: Payments {shape: cloud}

orders: orders {
  shape: sql_table
  id: int {constraint: primary_key}
  user_id: int {constraint: foreign_key}
  total: decimal
  currency: text
  status: text
  placed_at: timestamp
  paid_at: timestamp
  shipped_at: timestamp
}

client -> checkout.api: checkout
admin -> checkout.api: refund
checkout.api -> cache: session {style.stroke-dash: 3}
checkout.worker -> psp: charge
checkout.worker -> events: publish
checkout.worker -> orders: insert
