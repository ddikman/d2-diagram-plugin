# Order data model — an ER-style diagram of related tables.
# Probes: several sql_tables, constraints, crow's-foot-ish labelled relations, a lone enum.
direction: right

title: Order data model {
  near: top-center
  shape: text
  style: {font-size: 24; bold: true}
}

customers: customers {
  shape: sql_table
  id: int {constraint: primary_key}
  email: text {constraint: unique}
  created_at: timestamp
}

orders: orders {
  shape: sql_table
  id: int {constraint: primary_key}
  customer_id: int {constraint: foreign_key}
  status: order_status
  total: decimal
  placed_at: timestamp
}

order_items: order_items {
  shape: sql_table
  order_id: int {constraint: foreign_key}
  sku: text {constraint: foreign_key}
  qty: int
  unit_price: decimal
}

products: products {
  shape: sql_table
  sku: text {constraint: primary_key}
  name: text
  price: decimal
}

status: order_status {
  shape: class
  pending
  paid
  shipped
  refunded
}

customers -> orders: places (1:N)
orders -> order_items: contains (1:N)
products -> order_items: sold as (1:N)
status -> orders: enum {style.stroke-dash: 3}
