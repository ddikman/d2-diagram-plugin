# d2-diagram preset: adaptive — Neutral by day, dark by night: follows the viewer's OS theme. SVG only.
# Shared style for every diagram in this folder; diagrams import it via ...@_style. Edit freely.
vars: {
  d2-config: {
    theme-id: 0
    dark-theme-id: 200
    sketch: false
    layout-engine: dagre
    pad: 32
    data: {font: default; default-format: png; animated-format: gif; animate-interval: 1200}
  }
}
