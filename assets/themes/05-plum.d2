# d2 theme: plum — Plum ink and connections from the line chart on gold and cream fills, teal databases.
# Vivid sketch style. Diagrams import this file via ...@_style; edit it freely, it is plain D2.
vars: {
  d2-config: {
    theme-id: 0
    sketch: true
    layout-engine: dagre
    pad: 40
    theme-overrides: {
      B1: "#6c2b5c"
      B2: "#8e2c6b"
      B3: "#8e2c6b"
      B4: "#fbe7a1"
      B5: "#f8c848"
      B6: "#fde9b0"
      AA2: "#0888a8"
      AA4: "#0888a8"
      AA5: "#bfe6ec"
      AB4: "#f85838"
      AB5: "#fbd3c9"
      N1: "#3a2436"
      N2: "#5c4056"
      N3: "#7d5f77"
      N4: "#d9bfd0"
      N5: "#e6d3e0"
      N6: "#e2d8de"
      N7: "#fdfbf7"
    }
    data: {default-format: png; animated-format: gif; animate-interval: 1200}
  }
}

# Paper colour behind the whole diagram.
style.fill: "#f7f3ea"

# House style: made for slides and screens — large bold labels and heavy strokes.
***.style.font-size: 20
***.style.bold: true
***.style.stroke-width: 3
(*** -> ***)[*].style.stroke-width: 3
(*** -> ***)[*].style.font-size: 18

# d2 sizes a person from its label, which stretches the icon sideways for long names; pin the box.
***: {&shape: person; width: 64; height: 88}
