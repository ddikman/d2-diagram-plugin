...@_style
# Generated by class-diff.py from class-diff.json: edit that and re-run the script (plain d2 would render it without the pulse).

# Member types in slate instead of the house brick red: in a diff, red means removed.
vars: {d2-config: {theme-overrides: {AA2: "#4a5a6a"}}}

title: |md
  # #12 · Refunds move into Payment
| {near: top-center}

direction: down

c_customer: "Customer" {
  shape: class
  style.fill: "#6ccbd8"
  "-id": "UUID"
  "+placeOrder()"
}
c_order: "Order" {
  shape: class
  style.fill: "#6ccbd8"
  "-id": "UUID"
  "-total": "Money"
  "-refunded": "Boolean"
  "+cancel()": "Refund"
  "+cancel() "
}
c_payment: "Payment" {
  shape: class
  style.fill: "#6ccbd8"
  "-amount": "Money"
  "#gateway": "Gateway"
  "+refund(amount: Money)": "Refund"
}
c_refund: "Refund" {
  shape: class
  style.fill: "#2f9e44"
  "-amount": "Money"
  "-reason": "String"
}
c_refundservice: "RefundService" {
  shape: class
  style.fill: "#c8401f"
  "+refund(order: Order)": "Money"
}
c_customer -> c_order: "places"
c_order -> c_payment: "paid by"
c_order -> c_payment: "refunds via" {style.stroke: "#2f9e44"; style.font-color: "#2f9e44"; style.stroke-width: 6}
c_payment -> c_refund: "issues" {style.stroke: "#2f9e44"; style.font-color: "#2f9e44"; style.stroke-width: 6}
c_refundservice -> c_order: "refunds" {style.stroke: "#c8401f"; style.font-color: "#c8401f"; style.stroke-width: 6}
c_refundservice -> c_payment: "reverses" {style.stroke: "#c8401f"; style.font-color: "#c8401f"; style.stroke-width: 6}

legend: "" {
  near: bottom-center
  grid-rows: 2
  grid-columns: 2
  grid-gap: 10
  style: {fill: "#f3f1ea"; stroke-width: 1}
  *.style.font-size: 16
  *.style.bold: false
  gone: "" {style.fill: "#c8401f"; width: 24; height: 24}
  gone-label: "Removed by #12" {shape: text; style.font-color: "#c8401f"}
  new: "" {style.fill: "#2f9e44"; width: 24; height: 24}
  new-label: "Added by #12" {shape: text; style.font-color: "#2f9e44"}
}
