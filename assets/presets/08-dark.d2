# d2-diagram preset: dark — Dark background with the Inter font. Dark-mode docs and dark slide decks.
# Shared style for every diagram in this folder; diagrams import it via ...@_style. Edit freely.
vars: {
  d2-config: {
    theme-id: 200
    sketch: false
    layout-engine: dagre
    pad: 32
    data: {font: inter; default-format: png; animated-format: gif; animate-interval: 1200}
  }
}

# House style: dark backgrounds swallow drop shadows, so depth comes from rounding and weight.
***.style.border-radius: 10
***.style.font-size: 17
***.style.stroke-width: 2
***: {&leaf: false; style.bold: true}
(*** -> ***)[*].style.stroke-width: 2

# d2 sizes a person from its label, so a long name stretches the icon sideways.
# Pinning the box keeps people looking like people; the label still sits below it.
***: {&shape: person; width: 64; height: 88}
