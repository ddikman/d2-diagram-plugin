# d2 theme: sunset — Orange and yellow fills from the stacked area chart, deep red connections, teal databases.
# Vivid sketch style. Diagrams import this file via ...@_style; edit it freely, it is plain D2.
vars: {
  d2-config: {
    theme-id: 0
    sketch: true
    layout-engine: dagre
    pad: 40
    theme-overrides: {
      B1: "#3b2a26"
      B2: "#c8401f"
      B3: "#f85838"
      B4: "#fbd77a"
      B5: "#f89058"
      B6: "#f8c848"
      AA2: "#0888a8"
      AA4: "#0888a8"
      AA5: "#bfe6ec"
      AB4: "#8cc63f"
      AB5: "#dff0c2"
      N1: "#3b2a26"
      N2: "#5a453e"
      N3: "#7a6259"
      N4: "#f8c090"
      N5: "#f8d898"
      N6: "#e6dbd5"
      N7: "#fffaf0"
    }
    data: {default-format: png; animated-format: gif; animate-interval: 1200}
  }
}

# Paper colour behind the whole diagram.
style.fill: "#fbf4e6"

# House style: made for slides and screens — large bold labels and heavy strokes.
***.style.font-size: 20
***.style.bold: true
***.style.stroke-width: 3
(*** -> ***)[*].style.stroke-width: 3
(*** -> ***)[*].style.font-size: 18

# d2 sizes a person from its label, which stretches the icon sideways for long names; pin the box.
***: {&shape: person; width: 64; height: 88}
