# d2-diagram preset: sketch — Hand-drawn whiteboard feel. Recommended for RFCs and proposals that are still moving.
# Shared style for every diagram in this folder; diagrams import it via ...@_style. Edit freely.
vars: {
  d2-config: {
    theme-id: 0
    sketch: true
    layout-engine: dagre
    pad: 32
    data: {font: default; default-format: png; animated-format: gif; animate-interval: 1200}
  }
}
